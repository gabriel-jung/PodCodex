# deploy/.env.example — copy to deploy/.env and fill in values.
# Used by the Docker install path. The uv path uses `.env` at the repo root.

# Required — your Discord bot token.
DISCORD_TOKEN=

# Optional: the only Discord servers (comma-separated guild ids) the bot serves.
# Unset, it serves every server it is added to. See deploy/BOT.md.
# PODCODEX_ALLOWED_GUILDS=
